---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import '../styles/site.css';
import { publicationTopics, publications, publicationsByDate } from '../data/profile.ts';

const counts = Object.fromEntries(
	publicationTopics.map((topic) => [topic, publications.filter((p) => p.topic === topic).length]),
) as Record<(typeof publicationTopics)[number], number>;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Selected publications by Emiliano Bazaes: tutorials and articles on AI and machine learning, DevOps, and web development for SitePoint, DigitalOcean, and Compose."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Selected Publications, Emiliano Bazaes</title>
	</head>
	<body class="site">
		<Header current="publications" />

		<main id="main" class="container">
			<header class="page-head">
				<p class="eyebrow">Writing</p>
				<h1>Selected Publications</h1>
				<p class="lede">
					Tutorials and articles for SitePoint, DigitalOcean, and Compose, from Docker and static
					sites to recommender systems and GPT-3.
				</p>
				<div class="summary">
					<span><strong>{publications.length}</strong> pieces</span>
					{publicationTopics.map((topic) => (
						<span>
							<strong>{counts[topic]}</strong> {topic}
						</span>
					))}
				</div>
			</header>

			<div class="filters no-print" role="group" aria-label="Filter publications">
				<button class="filter active" type="button" data-filter="all" aria-pressed="true">All</button>
				{publicationTopics.map((topic) => (
					<button class="filter" type="button" data-filter={topic} aria-pressed="false">{topic}</button>
				))}
			</div>

			<div class="grid">
				{publicationsByDate.map((p) => (
					<article class="card" data-category={p.topic}>
						<div class="card-top">
							<span class="tag" data-cat={p.topic}>{p.topic}</span>
							<span class="year">{p.year}</span>
						</div>
						<h3>
							<a href={p.url} target="_blank" rel="noopener">{p.title}</a>
						</h3>
						<p class="meta">{p.kind} · {p.venue}</p>
						<p class="date">{p.date}</p>
						<a class="card-link" href={p.url} target="_blank" rel="noopener">Read ↗</a>
					</article>
				))}
			</div>

			<p class="empty" hidden>No publications in this topic.</p>
		</main>

		<Footer />

		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
			const cards = document.querySelectorAll<HTMLElement>('.card[data-category]');
			const empty = document.querySelector<HTMLElement>('.empty');

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const filter = btn.dataset.filter;
					buttons.forEach((b) => {
						const on = b === btn;
						b.classList.toggle('active', on);
						b.setAttribute('aria-pressed', String(on));
					});
					let visible = 0;
					cards.forEach((card) => {
						const show = filter === 'all' || card.dataset.category === filter;
						card.hidden = !show;
						if (show) visible++;
					});
					if (empty) empty.hidden = visible > 0;
				});
			});
		</script>
	</body>
</html>

<style>
	main {
		padding-block: clamp(2.5rem, 6vh, 4rem) 2rem;
	}

	.page-head {
		max-width: 52rem;
		margin-bottom: 2rem;
	}

	h1,
	h2,
	h3 {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 600;
	}

	h1 {
		font-size: clamp(2.2rem, 1.6rem + 3vw, 3.4rem);
	}

	h3 a {
		color: inherit;
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--accent);
	}

	.summary {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1.8rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.summary strong {
		display: block;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.8rem);
		font-weight: 600;
		color: var(--fg);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.8rem;
	}

	.filter {
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--rule);
		background: var(--surface);
		color: var(--muted);
		cursor: pointer;
	}

	.filter:hover {
		color: var(--fg);
	}

	.filter.active {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
		gap: 1.1rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		padding: 1.4rem;
		box-shadow: var(--shadow);
	}

	.card[hidden] {
		display: none;
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.9rem;
	}

	.tag {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		background: var(--accent-soft);
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
	}

	.year {
		font-size: 0.8rem;
		color: var(--muted);
	}

	.card h3 {
		margin-bottom: 0.35rem;
	}

	.meta,
	.date {
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0;
	}

	.card-link {
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		margin-top: auto;
		padding-top: 1rem;
	}

	.empty {
		text-align: center;
		color: var(--muted);
		padding: 3rem;
	}
</style>
