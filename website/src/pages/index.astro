---
import { marked } from 'marked';

const README_URL = 'https://raw.githubusercontent.com/luzdealba/luzdealba/main/README.md';

const response = await fetch(README_URL);
if (!response.ok) {
	throw new Error(`Failed to fetch README.md (${response.status} ${response.statusText}) from ${README_URL}`);
}

const content = await marked.parse(await response.text());
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Emiliano Bazaes — software engineer from Argentina, living in Thailand." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Emiliano Bazaes</title>
	</head>
	<body>
		<main>
			<article set:html={content} />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fbfaf7;
		--fg: #1a1a1a;
		--muted: #6b6b6b;
		--accent: #b4482a;
		--rule: #e3ded4;
		color-scheme: light dark;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #14130f;
			--fg: #ece8e1;
			--muted: #9a948a;
			--accent: #e08a6b;
			--rule: #2c2a24;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		line-height: 1.65;
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
	}

	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: clamp(2rem, 8vh, 5rem) 1.25rem 4rem;
	}

	h2,
	h3 {
		line-height: 1.25;
		text-wrap: balance;
	}

	h2 {
		margin-top: 0;
		font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
	}

	h3 {
		margin-top: 2.5rem;
		font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.4rem);
	}

	p,
	li {
		text-wrap: pretty;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.2em;
	}

	ul {
		padding-left: 1.25rem;
	}

	li + li {
		margin-top: 0.35rem;
	}

	hr {
		margin: 2.5rem 0 1.5rem;
		border: 0;
		border-top: 1px solid var(--rule);
	}

	hr + p {
		font-size: 0.95rem;
		line-height: 2;
	}

	@media print {
		body {
			background: #fff;
			color: #000;
		}
	}
</style>
